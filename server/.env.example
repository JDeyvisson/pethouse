DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pethouse
JWT_SECRET=replace-with-a-random-secret-before-running
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development
# Simulated subscriptions and email preview links. Always disabled in production.
MOCK_SERVICES=true
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads
